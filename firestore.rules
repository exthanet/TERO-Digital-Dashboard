rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Accounts are Firebase Auth users with a profile at users/{uid}:
    // { email, name, role: 'admin' | 'viewer', active: bool, createdAt }.
    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Signed in with Microsoft (company tenant) and a company email address.
    function viaMicrosoft() {
      return request.auth.token.firebase.sign_in_provider == 'microsoft.com';
    }
    function companyEmail() {
      return request.auth.token.email is string
        && request.auth.token.email.lower().matches('.*@terodigital[.]com');
    }
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().active == true
        && (!viaMicrosoft() || companyEmail());
    }
    function isAdmin() {
      return isActive() && profile().role == 'admin';
    }
    // Role presets; keep in step with PRESET in lib/auth/permissions.ts.
    function preset(role, name) {
      return role == 'admin'
        || (role == 'executive' && name in ['advanced', 'deepDive', 'revenue', 'download'])
        || (role == 'content' && name in ['advanced', 'deepDive', 'download'])
        || (role == 'finance' && name in ['revenue', 'download']);
    }
    // A permission of the signed-in person: admin always; else their own switch, else the role's.
    function can(name) {
      return isActive()
        && (profile().role == 'admin' || profile().get('perms', {}).get(name, preset(profile().role, name)) == true);
    }
    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'name', 'role', 'active', 'createdAt', 'mustChangePassword', 'perms'])
        && d.email is string
        && d.name is string
        && d.role in ['admin', 'executive', 'content', 'finance', 'viewer']
        && (!('perms' in d) || (d.perms is map && d.perms.keys().hasOnly(['advanced', 'deepDive', 'revenue', 'download'])))
        && d.active is bool
        && (!('mustChangePassword' in d) || d.mustChangePassword is bool);
    }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if isAdmin() && validProfile();
      // First Microsoft sign-in of a company account: its own profile, as an active viewer only.
      allow create: if signedIn() && request.auth.uid == uid && viaMicrosoft() && companyEmail()
        && validProfile()
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.role == 'viewer'
        && request.resource.data.active == true
        && request.resource.data.mustChangePassword == false;
      // Admins cannot demote or deactivate themselves, so one admin always remains.
      allow update: if isAdmin() && validProfile()
        && (uid != request.auth.uid
            || (request.resource.data.role == 'admin' && request.resource.data.active == true));
      // After setting their own password, a person clears the temporary-password
      // flag on their profile, and nothing else.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
        && request.resource.data.mustChangePassword == false;
      allow delete: if false;
    }

    // One document per login, written by the person logging in.
    // One per person per day the dashboard was opened (lib/auth/activity.ts): own entry only, admins read.
    match /visits/{id} {
      allow get: if isAdmin() || (isActive() && id.matches(request.auth.uid + '_.*'));
      allow list: if isAdmin();
      allow create: if isActive()
        && id == request.auth.uid + '_' + request.resource.data.day
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'day', 'method', 'firstAt', 'lastAt', 'opens'])
        && request.resource.data.opens == 1;
      allow update: if isActive()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAt', 'opens', 'method'])
        && request.resource.data.opens == resource.data.opens + 1;
    }
    // Files taken from the dashboard: each person adds their own, admins read.
    match /downloads/{id} {
      allow create: if isActive()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'kind', 'file', 'rows', 'at']);
      allow read: if isAdmin();
    }
    // Who changed whose access (lib/auth/users.ts logPermissionChange): admins only.
    match /permissionChanges/{id} {
      allow create: if isAdmin() && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /loginEvents/{id} {
      allow create: if isActive()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Written only by the daily sync (service account, IAM, not these rules).
    // Everyone signed in sees the short status; admins see the full run log.
    match /syncStatus/{doc} {
      allow read: if isActive();
      allow write: if false;
    }
    match /syncRuns/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /snapshots/{doc} {
      allow read: if isActive();
      allow write: if false;
    }
    // Tokens the sync uses (e.g. TikTok refresh tokens). No signed-in user may
    // read or write them, admins included: only the sync's service account,
    // which is not bound by these rules, touches them.
    // YouTube Deep Dive (watch time, revenue, search terms) from the sync: admins read, nobody writes from a browser.
    match /ytAnalytics/{doc} {
      allow read: if can('deepDive');
      allow write: if false;
    }
    // รายได้ → Monthly ACC (channel views and revenue per month) from the sync: admins read, nobody writes from a browser.
    match /accMonthly/{doc} {
      allow read: if can('revenue');
      allow write: if false;
    }
    // Daily backups in GitHub (download links), listed by the sync workflow: admins read, nobody writes from a browser.
    match /backups/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /syncSecrets/{doc} {
      allow read, write: if false;
    }
    // Cover-image links per platform for the thumbnail page (written by the sync only).
    match /thumbnails/{doc} {
      allow read: if isActive();
      allow write: if false;
    }
    // What each post gained per day (written by the sync only).
    match /growthDaily/{doc} {
      allow read: if isActive();
      allow write: if false;
    }
    // Backups of masterData taken before each sync write: never read or
    // written from the browser; restore with the sync script.
    match /masterDataBackups/{doc} {
      allow read, write: if false;
    }
    // Sync settings admins edit in the dashboard (TV workbook links).
    match /syncConfig/{doc} {
      allow read: if isAdmin();
      allow write: if isAdmin() && (
        (doc == "tvSources"
          && request.resource.data.keys().hasOnly(["sources", "updatedAt", "updatedBy"])
          && request.resource.data.sources is list
          && request.resource.data.sources.size() <= 20)
        || (doc == "notifications"
          && request.resource.data.keys().hasOnly(["emails", "mode", "updatedAt", "updatedBy"])
          && request.resource.data.emails is list
          && request.resource.data.emails.size() <= 10
          && request.resource.data.mode in ["always", "problems", "off"])
      );
    }
    // TV workbook tabs uploaded by an admin; the next sync merges them.
    match /tvUploads/{sourceId} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.sourceId == sourceId
        && request.resource.data.episodes is list
        && request.resource.data.episodes.size() <= 2000
        && request.resource.data.competitors is list;
    }
    // Competitor ratings from the TV workbook, written by the sync.
    match /tvCompetitors/{doc} {
      allow read: if isActive();
      allow write: if false;
    }

    match /masterData/{doc} {
      allow read: if isActive();
      allow write: if isAdmin();
    }
    // Compact gzipped copy of masterData for opening the dashboard fast; written
    // by the sync (service account) or by an admin right after saving masterData.
    match /dashboardCache/{doc} {
      allow read: if isActive();
      allow write: if isAdmin();
    }
    match /affiliateData/{doc} {
      allow read: if can('revenue');
      allow write: if isAdmin();
    }
    match /revenueData/{doc} {
      allow read: if can('revenue');
      allow write: if isAdmin();
    }
  }
}
